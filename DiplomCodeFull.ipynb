        "<a href=\"https://colab.research.google.com/github/KirillVidov/MailSorter/blob/main/DiplomCodeFull.ipynb\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
