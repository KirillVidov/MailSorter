    {
      "cell_type": "markdown",
      "source": [
        "# **МОДЕЛЬ**"
      ],
      "metadata": {
        "id": "r6VrzmQVl33-"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")"
      ],
      "metadata": {
        "id": "xDabz5LNl7t-"
      },
      "execution_count": 9,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Настройки\n",
        "MODEL_NAME = 'bert-base-multilingual-cased'\n",
        "\n",
        "# Чтение файла\n",
        "try:\n",
        "    df = pd.read_csv('labeled_emails.csv')\n",
        "except:\n",
        "    df = pd.read_csv('labeled_emails.csv', encoding='latin1')\n",
        "\n",
        "# Чистка\n",
        "df = df.dropna(subset=['Body', 'Category'])\n",
        "df['Category'] = df['Category'].astype(int)\n",
        "\n",
        "# Объединяем тему и текст\n",
