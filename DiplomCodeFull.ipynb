      "cell_type": "code",
      "source": [
        "def clean_text(text):\n",
        "    \"\"\"Очистка текста (как при обучении)\"\"\"\n",
        "    if not text: return \"\"\n",
        "    return text[:512]  # Обрезаем, чтобы не перегружать память"
      ],
      "metadata": {
        "id": "J1RCfv6CoTE4"
      },
      "execution_count": 20,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def get_body(msg):\n",
        "    \"\"\"Вытаскивает текст из письма\"\"\"\n",
        "    if msg.is_multipart():\n",
        "        for part in msg.walk():\n",
        "            if part.get_content_type() == \"text/plain\":\n",
        "                try:\n",
        "                    return part.get_payload(decode=True).decode()\n",
        "                except:\n",
        "                    pass\n",
        "    else:\n",
        "        try:\n",
        "            return msg.get_payload(decode=True).decode()\n",
        "        except:\n",
        "            pass\n",
        "    return \"\"\n"
      ],
      "metadata": {
        "id": "1np4VEmeoyv1"
      },
      "execution_count": 21,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def decode_str(header_value):\n",
        "    \"\"\"Декодирует тему письма\"\"\"\n",
        "    if not header_value: return \"\"\n",
        "    decoded_list = decode_header(header_value)\n",
        "    text_parts = []\n",
        "    for decoded_bytes, charset in decoded_list:\n",
        "        if isinstance(decoded_bytes, bytes):\n",
        "            try:\n",
        "                part = decoded_bytes.decode(charset or 'utf-8')\n",
        "            except:\n",
        "                part = decoded_bytes.decode('utf-8', errors='replace')\n",
        "            text_parts.append(part)\n",
        "        else:\n",
        "            text_parts.append(str(decoded_bytes))\n",
        "    return \"\".join(text_parts)"
      ],
      "metadata": {
        "id": "k15-iQ5oo1_0"
      },
      "execution_count": 22,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def predict_category(subject, sender, body):\n",
        "    \"\"\"Предсказывает категорию письма\"\"\"\n",
        "    # Собираем полный текст как при обучении\n",
        "    full_text = str(subject) + \" \" + str(sender) + \" \" + str(body)\n",
        "\n",
        "    inputs = tokenizer(\n",
        "        full_text,\n",
        "        return_tensors=\"pt\",\n",
        "        truncation=True,\n",
        "        padding=True,\n",
        "        max_length=512\n",
        "    ).to(device)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        logits = model(**inputs).logits\n",
        "\n",
        "    predicted_class_id = logits.argmax().item()\n",
        "    return predicted_class_id"
      ],
      "metadata": {
        "id": "k3KoHrzNo74c"
      },
      "execution_count": 23,
      "outputs": []
    },
