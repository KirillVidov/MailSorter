        "\n",
        "for epoch_i in range(0, epochs):\n",
        "    print(f'\\n======== Эпоха {epoch_i + 1} / {epochs} ========')\n",
        "    model.train()\n",
        "    total_train_loss = 0\n",
        "\n",
        "    for step, batch in enumerate(train_dataloader):\n",
        "        # Распаковка батча\n",
        "        b_input_ids = batch[0].to(device)\n",
